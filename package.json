{
  "name": "connector",
  "version": "0.0.0",
  "description": "P0's connector framework",
  "repository": "git@github.com:p0-security/connector.git",
  "private": true,
  "type": "module",
  "scripts": {
    ":build": "yarn workspaces foreach --all run build",
    ":test": "NODE_ENV=unit FORCE_COLOR=1 vitest run",
    ":format": "prettier --write '**/*.{html,js,ts,json,less,md}'",
    ":format:lint": "prettier --check '**/*.{html,js,ts,json,less,md}'",
    ":show-lockfile": "ln -s .yarn.lock yarn.lock",
    ":hide-lockfile": "rm yarn.lock",
    ":clean-node-modules": "find . -name 'node_modules' -type d -prune -print -exec rm -rf '{}' \\;",
    ":lint:code": "eslint . --max-warnings 0"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/express": "^4.17.25",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b"
}
