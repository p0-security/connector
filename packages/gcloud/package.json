    "@googleapis/compute": "^38.0.0",
    "@googleapis/iam": "^37.0.0",
    "@googleapis/iap": "^12.2.0",
    "@googleapis/secretmanager": "^7.0.0",
    "@googleapis/sqladmin": "^37.0.0",
    "@googleapis/storage": "^21.3.0",
    "@p0security/sp-shared": "workspace:*",
    "axios": "^1.17.0",
    "google-auth-library": "10.5.0",
    "googleapis-common": "^8.0.0",
    "lodash-es": "^4.17.23",
    "pino": "^8.21.0",
    "recheck": "^4.5.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/lodash-es": "^4.17.12",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
