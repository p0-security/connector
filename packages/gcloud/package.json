{
  "name": "@p0security/gcloud-common",
  "version": "1.0.0",
  "private": true,
  "description": "google cloud common functions",
  "type": "module",
  "exports": {
    "@p0security/development": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
