{
  "name": "@p0security/secret-manager-client",
  "version": "1.1.0",
  "description": "Shared client for interacting with secret manager providers",
  "type": "module",
  "exports": {
    ".": {
      "@p0security/development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "format": "prettier --write '**/*.{html,js,ts,json,less,md}'",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.975.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@p0security/gcloud-common": "workspace:^"
  },
  "devDependencies": {
    "@googleapis/secretmanager": "^7.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.(md|yaml|yml|json|js|ts|jsx|tsx)": "prettier --check"
  }
}
