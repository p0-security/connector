{
  "name": "@p0security/connector-sdk",
  "version": "0.0.3",
  "description": "P0's published SDK for building a Custom Application connector.",
  "author": "P0 Security",
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "p0",
    "p0security",
    "connector",
    "sdk"
  ],
  "homepage": "https://github.com/p0-security/connector/tree/main/packages/connector-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p0-security/connector.git",
    "directory": "packages/connector-sdk"
  },
  "bugs": {
    "url": "https://github.com/p0-security/connector/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!**/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@p0security/connector-development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./control-plane": {
      "@p0security/connector-development": "./src/control-plane.ts",
      "default": "./dist/control-plane.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "format": "prettier --write '**/*.{html,js,ts,json,less,md}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@p0security/connector-core": "workspace:^",
    "@trpc/server": "^11.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.(md|yaml|yml|json|js|ts|jsx|tsx)": "prettier --check"
  }
}
