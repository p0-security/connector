{
  "name": "@p0security/p0-connector-jira-ai",
  "version": "1.0.0",
  "description": "P0 Jira (AI) connector (GCP Cloud Run)",
  "type": "module",
  "exports": {
    ".": {
      "@p0security/development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./connector": {
      "@p0security/development": "./src/connector.ts",
      "default": "./dist/connector.js"
    }
  },
  "bin": "./dist/run.js",
  "scripts": {
    "format": "prettier --write '**/*.{html,js,ts,json,less,md}'",
    "typecheck": "tsc --noEmit",
    "just-bundle": "node ./esbuild.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build-within-docker": "yarn typecheck && yarn just-bundle",
    "build": "tsc --build"
  },
  "dependencies": {
    "@p0security/connector-core": "workspace:^",
    "@p0security/connector-secret-manager-client": "workspace:^",
    "@trpc/server": "^11.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "esbuild": "^0.27.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
