{
  "name": "@p0security/p0-connector-cloudsql",
  "version": "1.0.0",
  "description": "P0 CloudSQL connector (GCP Cloud Run only)",
  "type": "module",
  "exports": {
    "@p0security/development": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "bin": "./dist/run.js",
  "scripts": {
    "format": "prettier --write '**/*.{html,js,ts,json,less,md}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc --build"
  },
  "dependencies": {
    "@p0security/connector-core": "workspace:^",
    "@p0security/connector-gcloud-common": "workspace:*",
    "@p0security/p0-connector-mysql": "workspace:^",
    "@p0security/p0-connector-pg": "workspace:^",
    "@trpc/server": "^11.10.0",
    "gaxios": "^7.1.3",
    "lodash-es": "^4.17.23",
    "pino": "^9.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/lodash-es": "^4.17.12",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.1.3"
  },
  "lint-staged": {
    "*.(md|yaml|yml|json|js|ts|jsx|tsx)": "prettier --check"
  }
}
