{
  "name": "@p0security/p0-connector-pg",
  "version": "1.0.0",
  "description": "connector framework",
  "type": "module",
  "exports": {
    "@p0security/development": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "bin": {
    "connCli": "./dist/cli.js"
  },
  "scripts": {
    "format": "prettier --write '**/*.{html,js,ts,json,less,md}'",
    "typecheck": "tsc --noEmit",
    "just-bundle": "node ./esbuild.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "bundle": "yarn clean && yarn typecheck && yarn just-bundle && yarn zip-lambda",
    "zip-lambda": "cd dist && zip -r index.zip *.mjs* && du -sh index.zip",
    "build-within-docker": "yarn typecheck && yarn just-bundle",
    "build": "tsc --build"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.975.0",
    "@p0security/connector-cli": "workspace:^",
    "@p0security/connector-core": "workspace:^",
    "@p0security/gcloud-common": "workspace:^",
    "@trpc/client": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "aws-ssl-profiles": "^1.1.2",
    "knex": "^3.1.0",
    "pg": "^8.18.0",
    "pino": "^9.14.0",
    "type-fest": "^5.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/pg": "^8",
    "esbuild": "^0.27.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.(md|yaml|yml|json|js|ts|jsx|tsx)": "prettier --check"
  }
}
