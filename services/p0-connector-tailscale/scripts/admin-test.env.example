# Inputs for admin-test.sh, the Tailscale spec test (INT-666).
#
# Run admin-test.sh --setup to fill this in. It walks you through creating
# the two OAuth clients, finds the rest through the API, and writes .env in
# the folder you run it from (the default), or the path given with
# --env-file or ENV_FILE. It holds only IDs; don't commit it.
#
# Never put a secret here. The test reads every OAuth client secret hidden,
# when a check first needs it, and refuses to start if this file holds a line
# whose name contains SECRET. Values are KEY=value, no quotes needed.
# An empty optional value skips the checks that need it.

# ── The lab tailnet (required) ────────────────────────────────────────────

# The lab tailnet's Tailnet ID, from Settings > General (T...CNTRL), never the
# DNS name. The test runs only when TAILNET equals LAB_TAILNET, and asks you
# to type it again before it writes anything.
LAB_TAILNET=
TAILNET=
# Its DNS name, such as tail1234.ts.net. Optional: derived from a device name
# when empty.
TAILNET_DNS=

# ── Lab devices (required) ────────────────────────────────────────────────

# The requestor's login, as the Users page spells it. Device A is signed in
# as this login.
LOGIN=
# Device A: the machine you run the test on, untagged, signed in as LOGIN.
# Node IDs (n...CNTRL) are in each machine's details in the console.
DEVICE_A=
# Device B: tagged with TAG_B (which is in tagOwners), Tailscale SSH on
# (tailscale set --ssh), and a TCP listener on PORT_B.
DEVICE_B=
# B's Tailscale IP or MagicDNS name, as you'd type it on A.
DEVICE_B_HOST=
TAG_B=
PORT_B=
# A local user on B to SSH in as.
SSH_USER=

# ── OAuth clients (required) ──────────────────────────────────────────────

# Admin client, the test's own: it writes test postures and posture-gated
# grants into the lab policy file, which the connector never does. Scopes:
# policy_file users:read devices:core:read devices:posture_attributes
# devices:routes:read services:read
ADMIN_CLIENT_ID=
# The connector's client, with exactly the connector's scopes:
# policy_file:read users:read devices:core:read devices:posture_attributes
# devices:routes:read services:read
PO_CLIENT_ID=
# The scopes each client was created with, space-separated, when they differ
# from the lists above (A02 compares them with what a mint reports).
ADMIN_SCOPES=
PO_SCOPES=

# ── Federated identities (optional: federated area) ───────────────────────

# AWS: a federated identity whose issuer is the account's outbound identity
# federation issuer and whose subject is FED_AWS_ROLE_ARN. The test assumes
# that throwaway role (your SSO role must be allowed to), then mints an
# ES384 GetWebIdentityToken of 300 s for api.tailscale.com/<client ID>. It
# runs aws sso login itself when the profile has no session.
FED_AWS_CLIENT_ID=
FED_AWS_ROLE_ARN=
# The AWS CLI profile to sign in with (empty: the default chain), and a
# region for the regional STS endpoint GetWebIdentityToken needs.
SPEC_AWS_PROFILE=
SPEC_AWS_REGION=us-west-2
# The identity's configured scopes, when not the connector's list (A12).
FED_AWS_SCOPES=

# GCP: a federated identity with issuer https://accounts.google.com and the
# service account's unique ID as subject. The test runs gcloud auth login if
# no account is active, then mints an ID token by impersonating FED_GCP_SA
# (you need roles/iam.serviceAccountTokenCreator on it).
FED_GCP_CLIENT_ID=
FED_GCP_SA=
GCP_PROJECT=
FED_GCP_SCOPES=

# ── Optional extras ───────────────────────────────────────────────────────

# RO: an OAuth client with all:read. ALL: one with all. (A10)
RO_CLIENT_ID=
ALL_CLIENT_ID=

# A node ID from another tailnet, for the 404 checks (A20).
OTHER_TAILNET_DEVICE=
# S: a device shared in from a second tailnet (A70).
SHARED_DEVICE=

# FREE: a second tailnet on the Personal plan, an OAuth client there with
# devices:posture_attributes, and one of its devices (A27).
FREE_TAILNET=
FREE_CLIENT_ID=
FREE_DEVICE=

# A spare device you can sign out and back in as another user (A75).
SPARE_DEVICE=

# C: a subnet router with ROUTER_SUBNET approved, to check postures don't
# gate traffic from behind it (A65, A72).
DEVICE_C=
ROUTER_SUBNET=10.99.0.0/24

# SVC: a Tailscale Service, such as svc:spec, that A82 expects /services to
# list.
SERVICE_NAME=

# ── Tuning ────────────────────────────────────────────────────────────────

# Requests per burst in the rate-limit check (A91).
RATE_BURST=20
# How long A07 holds a token before trying it again.
TOKEN_WAIT_MINUTES=50
